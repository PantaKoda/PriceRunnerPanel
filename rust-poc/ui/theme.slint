// "Clean room HUD" palette, the same values as App.axaml (Slint writes alpha last: #rrggbbaa).
export global Theme {
    out property <color> accent: #0088AE;
    out property <color> accent-dark: #006A88;
    out property <color> accent-soft: #0088AE1A;
    out property <color> frame: #0088AE59;
    out property <color> dim: #56637A;
    out property <color> text: #132036;
    out property <color> hover: #0088AE14;
    out property <color> panel: #0088AE0C;
    out property <color> card: #FFFFFFC8;
    out property <color> card-in-group: #FFFFFFE6;
    out property <color> card-border: #0088AE2E;
    out property <color> down: #0B9463;
    out property <color> down-soft: #0B946316;
    out property <color> up: #CC2D4F;
    out property <color> up-soft: #CC2D4F14;
    out property <color> warn: #B86200;
    out property <color> warn-soft: #E07A0018;
    out property <color> target: #7A4DE0;
    out property <color> target-soft: #7A4DE016;
    out property <brush> surface: @linear-gradient(135deg, #FBFDFF 0%, #EEF5FC 55%, #E2ECF8 100%);
}

