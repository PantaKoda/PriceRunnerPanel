<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PriceRunnerPanel.ViewModels"
        xmlns:c="using:PriceRunnerPanel.Controls"
        x:Class="PriceRunnerPanel.Views.UpdateWindow"
        x:DataType="vm:UpdateViewModel"
        Title="PriceRunner Panel update"
        Width="500" Height="560" MinWidth="360" MinHeight="340"
        WindowDecorations="None"
        CanResize="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
  </Window.KeyBindings>

  <Panel Margin="10">
    <Border CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource SpaceSurfaceBrush}" BoxShadow="{StaticResource PanelShadow}" />
    <Border CornerRadius="{StaticResource RadiusLarge}" Background="{DynamicResource GlowBrush}" IsHitTestVisible="False" />
    <Border CornerRadius="{StaticResource RadiusLarge}" ClipToBounds="True">
      <c:StarField />
    </Border>
    <c:HudCorners Stroke="{DynamicResource HudFrameBrush}" Length="16" Margin="2" />

    <Border CornerRadius="{StaticResource RadiusLarge}" BorderBrush="{DynamicResource HudFrameBrush}" BorderThickness="1">
      <DockPanel Margin="18,10,18,16">
        <!-- Header: drag to move -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="OnHeaderPointerPressed" Margin="0,0,-10,6">
          <TextBlock Classes="brand" Text="◆ SOFTWARE UPDATE" FontSize="12.5" LetterSpacing="2.2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon danger" Click="OnCloseClick" ToolTip.Tip="Close" AutomationProperties.Name="Close">
            <PathIcon Data="{StaticResource IconClose}" />
          </Button>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
          <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" Text="{Binding Summary}" TextWrapping="Wrap" TextTrimming="None" FontSize="12" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
          <ProgressBar IsVisible="{Binding ShowProgress}" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="4" MinHeight="4"
                       Foreground="{DynamicResource HudAccentBrush}" />
          <ProgressBar Classes="scan" IsVisible="{Binding IsBusy}" />
          <TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="{Binding PreviousFailure}" IsVisible="{Binding HasPreviousFailure}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource UpBrush}" />
          <TextBlock Classes="secondary" Text="{Binding InstallHint}" IsVisible="{Binding HasInstallHint}" TextWrapping="Wrap" TextTrimming="None" />
          <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="accent" Content="Install update" Command="{Binding InstallCommand}"
                    ToolTip.Tip="Downloads the release from GitHub, checks it against its published checksum, then restarts into the new version. Your watchlist and settings are kept." />
            <Button Classes="pill" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                    ToolTip.Tip="Stops the download. Nothing is changed." />
            <Button Classes="pill" Content="View on GitHub" Command="{Binding ViewOnGitHubCommand}" />
            <Button Classes="pill" Content="Check again" Command="{Binding CheckAgainCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Classes="pill" Content="Later" Click="OnCloseClick" />
          </WrapPanel>
        </StackPanel>

        <Panel>
        <!-- Nothing newer: a calm "you're on the latest version" instead of an empty notes box. -->
        <StackPanel IsVisible="{Binding !HasReleases}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
          <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource DownSoftBrush}"
                  BorderBrush="{DynamicResource DownBrush}" BorderThickness="1" HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource DownBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="hud" Text="YOU'RE ON THE LATEST VERSION" HorizontalAlignment="Center" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" TextTrimming="None"
                     Text="The panel checks GitHub twice a day and shows an UPDATE button when a new release is out." />
        </StackPanel>

        <!-- What changed, newest release first (plain text) -->
        <Border Classes="card" Margin="0" Padding="0" IsVisible="{Binding HasReleases}">
          <ScrollViewer Padding="14,10">
            <ItemsControl ItemsSource="{Binding Releases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReleaseNotesItem">
                  <StackPanel Spacing="4" Margin="0,2,0,14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="title" Text="{Binding Title}" Foreground="{DynamicResource HudAccentBrush}" />
                      <TextBlock Classes="secondary" Text="{Binding DateText}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <SelectableTextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="12.5" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        </Panel>
      </DockPanel>
    </Border>
  </Panel>
</Window>
