<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PriceRunnerPanel.ViewModels"
             x:Class="PriceRunnerPanel.Views.TelegramSettingsView"
             x:DataType="vm:TelegramSettingsViewModel">
  <StackPanel Width="290" Spacing="6">
    <TextBlock Classes="hud" Text="TELEGRAM" />
    <TextBlock Classes="secondary" TextWrapping="Wrap"
               Text="Sent through your own bot while this app is running. Paste its token, send the bot any message in Telegram, then click below." />
    <TextBox Text="{Binding Token}" PasswordChar="•" PlaceholderText="{Binding TokenHint}" AutomationProperties.Name="Bot token" />
    <TextBox Text="{Binding ChatId}" PlaceholderText="Chat ID (optional, found for you)" AutomationProperties.Name="Chat ID" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
      <Button Classes="accent" Content="Save and send test" Command="{Binding SaveAndTestCommand}" IsEnabled="{Binding IsIdle}"
              AutomationProperties.Name="Save Telegram and send test" />
      <Button Grid.Column="1" Classes="link" Command="{Binding RemoveCommand}" IsVisible="{Binding IsConfigured}" VerticalAlignment="Center"
              AutomationProperties.Name="Remove Telegram">
        <TextBlock Classes="secondary" Text="Remove" Foreground="{DynamicResource HudAccentBrush}" />
      </Button>
    </Grid>
    <TextBlock Classes="secondary" Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
