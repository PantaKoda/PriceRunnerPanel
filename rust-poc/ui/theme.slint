}

export component Icon inherits Rectangle {
    in property <string> d;
    in property <color> tint: Theme.dim;
    in property <length> size: 14px;
    width: size; height: size;
    Path { commands: d; fill: tint; viewbox-width: 24; viewbox-height: 24; width: 100%; height: 100%; }
}

// Compact icon-only button.
export component IconButton inherits Rectangle {
    in property <string> d;
    in property <bool> danger;
    in property <bool> busy;
    in property <length> icon-size: 14px;
    callback clicked;
    width: 28px; height: 28px; border-radius: 6px;
    background: ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: MouseCursor.pointer; }
    Icon { d: root.d; size: root.icon-size; tint: root.busy ? Theme.accent : ta.has-hover ? (root.danger ? Theme.up : Theme.accent) : Theme.dim; }
}

// Small rounded label with a soft fill. kind: 0 plain, 1 down, 2 up, 3 warn, 4 target, 5 solid, 6 variant.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <length> max-text-width: 200px;
    border-radius: 8px; border-width: 1px;
    border-color: kind == 1 ? Theme.down : kind == 2 ? Theme.up : kind == 3 ? Theme.warn : kind == 4 ? Theme.target : kind == 5 ? Theme.down : kind == 6 ? Theme.accent : Theme.frame;
    background: kind == 1 ? Theme.down-soft : kind == 2 ? Theme.up-soft : kind == 3 ? Theme.warn-soft : kind == 4 ? Theme.target-soft : kind == 5 ? Theme.down : kind == 6 ? white : Theme.panel;
    width: t.width + 13px; height: t.preferred-height + 4px;
    t := Text {
        x: 6px; y: 2px; text: root.text; font-size: 10.5px; font-weight: 600; overflow: elide;
        width: min(self.preferred-width, root.max-text-width); letter-spacing: kind == 5 ? 1.2px : 0;
        color: kind == 1 ? Theme.down : kind == 2 ? Theme.up : kind == 3 ? Theme.warn : kind == 4 ? Theme.target : kind == 5 ? white : kind == 6 ? Theme.accent : Theme.dim;
    }
}

// Accent action button ("Check now"), quiet pill, or an active (filled) choice.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <string> d;
    in property <bool> accent;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> font-size: 11px;
    callback clicked;
    height: 26px; border-radius: 13px; border-width: 1px;
    width: l.preferred-width;
    border-color: accent ? transparent : (ta.has-hover || active) ? Theme.accent : Theme.card-border;
    background: accent ? (ta.has-hover ? Theme.accent-dark : Theme.accent) : active ? Theme.accent : white;
    opacity: enabled ? 1 : 0.5;
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } mouse-cursor: MouseCursor.pointer; }
    l := HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 5px; alignment: center;
        if d != "" : Icon { d: root.d; size: 11px; tint: (accent || active) ? white : (ta.has-hover ? Theme.accent : Theme.text); }
        Text { text: root.text; font-size: root.font-size; font-weight: accent ? 600 : 400; vertical-alignment: center; color: (accent || active) ? white : (ta.has-hover ? Theme.accent : Theme.text); }
    }
}

// Quiet text link.
export component Link inherits Rectangle {
    in property <string> text;
    in property <string> d;
    in property <color> tint: Theme.dim;
    in property <length> font-size: 11px;
    in property <int> font-weight: 400;
    callback clicked;
    min-width: 0; height: l.preferred-height;
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: MouseCursor.pointer; }
    l := HorizontalLayout {
        spacing: 5px;
        if d != "" : Icon { d: root.d; size: 10px; tint: Theme.accent; }
        Text { text: root.text; font-size: root.font-size; font-weight: root.font-weight; color: ta.has-hover ? Theme.accent : root.tint; vertical-alignment: center; overflow: elide; min-width: 0; }
    }
}

// Search box: a white capsule with a cyan focus ring and a clear button.
export component SearchBox inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    callback cleared;
    in property <bool> autofocus;
    init => { if (autofocus) { input.focus(); } }
    height: 38px; border-radius: 19px; background: white; border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Theme.accent : ta.has-hover ? Theme.frame : Theme.card-border;
    ta := TouchArea { clicked => { input.focus(); } mouse-cursor: MouseCursor.text; }
    Icon { x: 13px; y: (parent.height - self.height) / 2; d: Icons.search; size: 15px; tint: Theme.accent; }
    input := TextInput {
        x: 34px; y: (parent.height - self.height) / 2; width: parent.width - 34px - 34px; height: self.preferred-height;
        font-size: 13.5px; color: Theme.text; single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        key-pressed(e) => { if (e.text == Key.Escape) { root.cleared(); return accept; } return reject; }
    }
    if input.text == "" : Text { x: 34px; y: (parent.height - self.height) / 2; text: root.placeholder; font-size: 13.5px; color: Theme.dim; }
    if input.text != "" : IconButton { x: parent.width - 33px; y: 5px; d: Icons.clear; clicked => { root.cleared(); } }
}

// Small text field (target price, discount percent).
export component SmallEdit inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <TextHorizontalAlignment> align: left;
    callback accepted(string);
    callback edited(string);
    callback focus-lost(string);
    height: 26px; border-radius: 6px; background: white; border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.card-border;
    TouchArea { clicked => { input.focus(); } mouse-cursor: MouseCursor.text; }
    input := TextInput {
        x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px; height: self.preferred-height;
        font-size: 12px; color: Theme.text; single-line: true; horizontal-alignment: root.align;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        changed has-focus => { if (!self.has-focus) { root.focus-lost(self.text); } }
    }
    if input.text == "" : Text { x: 8px; y: (parent.height - self.height) / 2; width: parent.width - 16px; text: root.placeholder; font-size: 12px; color: Theme.dim; horizontal-alignment: root.align; }
}

// Thin indeterminate "scan line" shown while something is active.
export component ScanLine inherits Rectangle {
    height: 2px; clip: true;
    Rectangle {
        property <float> pos: 0;
        width: 30%; height: 100%; background: Theme.accent; border-radius: 1px;
        x: -self.width + (parent.width + self.width) * pos;
        animate pos { duration: 1100ms; iteration-count: -1; }
        init => { pos = 1; }
    }
}
