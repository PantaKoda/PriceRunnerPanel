    out property <string> deal: "M2 3.5C2 2.67 2.67 2 3.5 2h7.17c.4 0 .78.16 1.06.44l9.83 9.83c.59.59.59 1.54 0 2.12l-7.17 7.17c-.59.59-1.54.59-2.12 0L2.44 11.73A1.5 1.5 0 0 1 2 10.67V3.5zM7 8.75a1.75 1.75 0 1 0 0-3.5 1.75 1.75 0 0 0 0 3.5z";
    out property <string> brand: "M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z";
    out property <string> layers: "M12 16.54 4.63 10.8 3 12.07l9 7 9-7-1.64-1.28L12 16.54zM12 14l7.36-5.73L21 7l-9-7-9 7 1.63 1.27L12 14z";
