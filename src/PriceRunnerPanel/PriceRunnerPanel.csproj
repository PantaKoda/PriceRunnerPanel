<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Two builds of one app: Windows (WinRT toasts, COM shortcut, registry) and Linux (D-Bus portals). Each build only
         compiles its own Platform/<OS> folder, so the Linux one carries no WinRT or COM code. -->
    <TargetFrameworks>net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <AssemblyName>PriceRunnerPanel</AssemblyName>
    <RootNamespace>PriceRunnerPanel</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Release RIDs (scripts/publish-windows.ps1, scripts/publish-linux.sh); listed so restore and packages.lock.json
         match the release publish. -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <!-- Lets the Linux release runner restore the Windows target too (restore always covers every target). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Published builds are precompiled (ReadyToRun): the window shows in about half the time and startup uses half the
         CPU, at the cost of a larger zip. Set here rather than on the publish command so the locked restore records the
         compiler pack. Builds and runs from source are unaffected. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PriceRunnerPanel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <Compile Remove="Platform\Linux\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'windows'">
    <!-- The same version Avalonia.FreeDesktop already ships for the tray icon: no extra package in the build. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\PriceRunnerPanel.ico" />
  </ItemGroup>
</Project>
