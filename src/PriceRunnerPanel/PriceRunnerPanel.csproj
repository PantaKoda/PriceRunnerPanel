<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>PriceRunnerPanel</AssemblyName>
    <RootNamespace>PriceRunnerPanel</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PriceRunnerPanel.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Release RID (scripts/publish-windows.ps1); listed so restore and packages.lock.json match the release publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Published builds are precompiled (ReadyToRun): the window shows in about half the time and startup uses half the
         CPU, at the cost of a larger zip. Set here rather than on the publish command so the locked restore records the
         compiler pack. Builds and runs from source are unaffected. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\PriceRunnerPanel.ico" />
  </ItemGroup>
</Project>
